        "long":  { "thai": "อือ", "roman": "ʉʉ", "mean": "long ʉʉ", "example": { "thai": "มือ", "roman": "mʉʉ", "mean": "hand" } } },
      { "short": { "thai": "อุ", "roman": "u", "mean": "short u, as in ‘put’", "example": { "thai": "ดุ", "roman": "dù", "mean": "fierce; to scold" } },
