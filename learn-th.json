  "romanization": {
    "intro": "Romanization is only a guide: listen to the voice and copy it. Long vowels are written twice (aa, ii, uu). The accent shows the tone, and no accent means mid tone.",
    "keys": [
      { "sym": "maa", "say": "mid tone (no accent)" },
      { "sym": "màa", "say": "low tone" },
      { "sym": "mâa", "say": "falling tone" },
      { "sym": "máa", "say": "high tone" },
      { "sym": "mǎa", "say": "rising tone" },
      { "sym": "g · bp · dt", "say": "no puff of air (as in skin, spin, stop)" },
      { "sym": "kh · ph · th", "say": "with a puff of air. ph is never f, th is never the th in ‘the’" },
      { "sym": "ɔ", "say": "aw, as in ‘law’" },
      { "sym": "ɛ", "say": "a, as in ‘cat’" },
      { "sym": "ə", "say": "er, as in ‘her’ (no r)" },
      { "sym": "ʉ", "say": "say ‘oo’ while smiling" }
    ]
  },

  "tones": {
    "intro": "Thai has five tones. The tone is part of the word: the same sound with a different tone is a different word. Listen to each tone, then to the sets of words below that differ only by tone.",
