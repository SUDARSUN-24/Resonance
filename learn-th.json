        "word": { "thai": "มา", "roman": "maa", "mean": "to come" } },
      { "id": "low", "name": "Low", "thai": "เสียงเอก", "roman": "sǐang èek", "mean": "low tone", "contour": [2, 1],
        "how": "Level and low, a little below your normal voice.", "mark": "่",
        "word": { "thai": "ไก่", "roman": "gài", "mean": "chicken" } },
      { "id": "falling", "name": "Falling", "thai": "เสียงโท", "roman": "sǐang thoo", "mean": "falling tone", "contour": [4.5, 1],
        "how": "Starts high and drops, like a firm ‘No!’.", "mark": "้",
        "word": { "thai": "ไม่", "roman": "mâi", "mean": "not" } },
      { "id": "high", "name": "High", "thai": "เสียงตรี", "roman": "sǐang dtrii", "mean": "high tone", "contour": [4, 5],
        "how": "High and rising a little, a bit tense.", "mark": "๊",
        "word": { "thai": "ม้า", "roman": "máa", "mean": "horse" } },
      { "id": "rising", "name": "Rising", "thai": "เสียงจัตวา", "roman": "sǐang jàt-dtà-waa", "mean": "rising tone", "contour": [2, 1.2, 4.5],
        "how": "Dips, then rises, like a surprised ‘Really?’.", "mark": "๋",
        "word": { "thai": "หมา", "roman": "mǎa", "mean": "dog" } }
