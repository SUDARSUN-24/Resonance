      "rows": [
        { "class": "mid", "tones": ["mid", "low", "low", "falling", "high", "rising"] },
        { "class": "high", "tones": ["rising", "low", "low", "falling", null, null] },
        { "class": "low", "tones": ["mid", "high (short vowel) · falling (long vowel)", "falling", "high", null, null] }
      ],
      "examples": [
        { "thai": "กา", "roman": "gaa", "mean": "crow", "why": "middle class, live → mid" },
        { "thai": "กัด", "roman": "gàt", "mean": "to bite", "why": "middle class, dead → low" },
        { "thai": "ขา", "roman": "khǎa", "mean": "leg", "why": "high class, live → rising" },
        { "thai": "ข้าว", "roman": "khâao", "mean": "rice", "why": "high class + second tone mark → falling" },
        { "thai": "นก", "roman": "nók", "mean": "bird", "why": "low class, dead, short vowel → high" },
        { "thai": "มาก", "roman": "mâak", "mean": "very, a lot", "why": "low class, dead, long vowel → falling" },
