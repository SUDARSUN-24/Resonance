  "sounds": {
    "intro": "The sounds English speakers find hardest. Each group is a set of words that only differ by that sound, so listen closely and copy.",
    "groups": [
      { "title": "With or without a puff of air", "tip": "Hold your hand in front of your mouth. g, bp and dt have no puff of air, like the k in ‘skin’ or the p in ‘spin’. kh, ph and th have a puff, like ‘kin’ or ‘pin’. Thai also has a true b and d.",
        "pairs": [
          [ { "thai": "ไก่", "roman": "gài", "mean": "chicken" }, { "thai": "ไข่", "roman": "khài", "mean": "egg" } ],
          [ { "thai": "ตา", "roman": "dtaa", "mean": "eye; grandfather (mother’s father)" }, { "thai": "ทา", "roman": "thaa", "mean": "to paint on, to apply" } ],
          [ { "thai": "ปา", "roman": "bpaa", "mean": "to throw" }, { "thai": "พา", "roman": "phaa", "mean": "to take someone along" } ],
          [ { "thai": "ใบ", "roman": "bai", "mean": "leaf; sheet" }, { "thai": "ไป", "roman": "bpai", "mean": "to go" } ],
          [ { "thai": "ดี", "roman": "dii", "mean": "good" }, { "thai": "ตี", "roman": "dtii", "mean": "to hit" } ]
        ] },
      { "title": "Short and long vowels", "tip": "Same consonants, same tone: only the vowel length changes. Make the long vowel about twice as long.",
        "pairs": [
          [ { "thai": "หัด", "roman": "hàt", "mean": "to practise" }, { "thai": "หาด", "roman": "hàat", "mean": "beach" } ],
          [ { "thai": "ขุด", "roman": "khùt", "mean": "to dig" }, { "thai": "ขูด", "roman": "khùut", "mean": "to scrape" } ],
          [ { "thai": "ฝัน", "roman": "fǎn", "mean": "to dream" }, { "thai": "ฝาน", "roman": "fǎan", "mean": "to slice thinly" } ],
          [ { "thai": "เล็ก", "roman": "lék", "mean": "small" }, { "thai": "เลข", "roman": "lêek", "mean": "number" } ]
        ],
        "note": "In เล็ก and เลข the tone changes too, because a low-class dead syllable takes a high tone when the vowel is short and a falling tone when it is long." },
